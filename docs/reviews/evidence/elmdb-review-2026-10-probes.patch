+#[test]
+fn review_check_accepts_duplicate_unindexed_unique_values() {
+    let dir = tempfile::tempdir().unwrap();
+    let db = open(&dir);
+    let value = "a".repeat(257);
+    let loads = ["Task-1", "Task-2"].into_iter().map(|id|
+        serde_json::from_value(json!({"load":"entity","id":id,"fields":{"slug":value}})).unwrap()
+    ).collect::<Vec<_>>();
+    db.bulk_load(&loads).unwrap();
+    let report = db.check().unwrap();
+    assert!(report.differences.is_empty(), "{:?}", report);
+    assert!(report.violations.is_empty(), "duplicate is not reported: {:?}", report);
+}
