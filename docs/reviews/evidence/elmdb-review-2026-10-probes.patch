+#[test]
+fn review_check_accepts_cycle_loaded_unchecked() {
+    let dir = tempfile::tempdir().unwrap();
+    let db = open(&dir);
+    let loads = vec![
+       json!({"load":"entity","id":"Task-1","fields":{}}),
+       json!({"load":"entity","id":"Task-2","fields":{}}),
+       json!({"load":"relation","id":"Relation-1","kind":"parent_of","source":"Task-1","target":"Task-2"}),
+       json!({"load":"relation","id":"Relation-2","kind":"parent_of","source":"Task-2","target":"Task-1"})
+    ].into_iter().map(|v| serde_json::from_value(v).unwrap()).collect::<Vec<_>>();
+    db.bulk_load(&loads).unwrap();
+    let report = db.check().unwrap();
+    assert!(report.differences.is_empty(), "{:?}", report);
+    assert!(report.violations.is_empty(), "cycle is not reported: {:?}", report);
+}
