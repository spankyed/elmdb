+#[test]
+fn review_reset_commits_without_notifying_when_sync_fails() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let dir = tempfile::tempdir().unwrap();
+    let db = open(&dir);
+    write(&db, vec![json!({"op":"create","type":"Task","id":"Task-1","fields":{"a":1}})]).unwrap();
+    db.close().unwrap();
+    let db = Database::open(dir.path(), crate::OpenOptions::default()).unwrap();
+    let count = Arc::new(AtomicUsize::new(0));
+    let c = count.clone();
+    db.watch(reads(vec![row("Task-1")], None), Box::new(move |_| { c.fetch_add(1, Ordering::SeqCst); })).unwrap();
+    crate::store::REVIEW_FAIL_SYNC.store(true, Ordering::SeqCst);
+    let result = db.reset();
+    crate::store::REVIEW_FAIL_SYNC.store(false, Ordering::SeqCst);
+    assert_eq!(result.unwrap_err().code, crate::ErrorCode::Io);
+    let bytes = db.read(&reads(vec![row("Task-1")], None)).unwrap();
+    let answer: Json = serde_json::to_value(rmpv::decode::read_value(&mut &bytes[..]).unwrap()).unwrap();
+    assert!(answer[0]["row"].is_null(), "reset committed");
+    assert_eq!(count.load(Ordering::SeqCst), 1, "watch was not notified");
+    assert!(db.close().is_err());
+}
