+#[test]
+fn review_schema_sync_failure_leaves_memory_and_disk_disagreeing() {
+    use std::sync::atomic::Ordering;
+    let dir = tempfile::tempdir().unwrap();
+    let db = open(&dir);
+    db.close().unwrap();
+    let db = Database::open(dir.path(), crate::OpenOptions::default()).unwrap();
+    let mut new_schema = super::schema();
+    new_schema.types.get_mut("Task").unwrap().fields.remove("a");
+    crate::store::REVIEW_FAIL_SYNC.store(true, Ordering::SeqCst);
+    let result = db.set_schema(new_schema);
+    crate::store::REVIEW_FAIL_SYNC.store(false, Ordering::SeqCst);
+    assert_eq!(result.unwrap_err().code, crate::ErrorCode::Io);
+    assert!(db.schema().unwrap().types["Task"].fields.contains_key("a"));
+    assert!(db.close().is_err());
+    let reopened = Database::open(dir.path(), crate::OpenOptions { syncs:false, ..Default::default() }).unwrap();
+    assert!(!reopened.schema().unwrap().types["Task"].fields.contains_key("a"));
+}
