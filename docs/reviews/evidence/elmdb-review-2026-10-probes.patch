+#[test]
+fn review_callback_close_cannot_obtain_exclusive_store() {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    let dir = tempfile::tempdir().unwrap();
+    let db = Arc::new(open(&dir));
+    let weak = Arc::downgrade(&db);
+    let closed = Arc::new(AtomicBool::new(true));
+    let c = closed.clone();
+    let id = db.watch(reads(vec![row("Task-1")], None), Box::new(move |_| {
+        let db = weak.upgrade().unwrap();
+        c.store(db.close_within(Some(std::time::Duration::ZERO)).unwrap(), Ordering::SeqCst);
+    })).unwrap();
+    assert!(!closed.load(Ordering::SeqCst));
+    db.unwatch(id);
+    db.close().unwrap();
+}
