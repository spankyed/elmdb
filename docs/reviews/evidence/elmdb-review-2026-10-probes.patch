+#[test]
+fn review_listener_panic_disables_watch() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let dir = tempfile::tempdir().unwrap();
+    let db = open(&dir);
+    write(&db, vec![json!({"op":"create","type":"Task","id":"Task-1","fields":{"a":1}})]).unwrap();
+    let count = Arc::new(AtomicUsize::new(0));
+    let c = count.clone();
+    let id = db.watch(reads(vec![row("Task-1")], None), Box::new(move |_| {
+        if c.fetch_add(1, Ordering::SeqCst) == 1 { panic!("listener failure"); }
+    })).unwrap();
+    let failed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        write(&db, vec![json!({"op":"set","id":"Task-1","fields":{"a":2}})]).unwrap();
+    }));
+    assert!(failed.is_err());
+    write(&db, vec![json!({"op":"set","id":"Task-1","fields":{"a":3}})]).unwrap();
+    assert_eq!(count.load(Ordering::SeqCst), 2, "watch remains registered but no longer invokes listener");
+    assert!(db.track_stats().0 > 0);
+    db.unwatch(id);
+}
