{
  "name": "elmdb",
  "version": "0.0.0",
  "description": "An embedded graph database for ECMAScript, written in Rust on LMDB",
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/spankyed/elmdb.git", "directory": "crates/elmdb-node" },
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "protocol/", "*.node"],
  "engines": { "node": ">=22.17.0" },
  "napi": {
    "binaryName": "elmdb",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9"
  }
}
