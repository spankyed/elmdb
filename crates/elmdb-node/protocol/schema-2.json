{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmdb.dev/schema/2.json",
  "title": "Schema",
  "description": "Top-level elmdb v2 schema definition (exported to TS & JSON Schema).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/TypeDefinition"
      },
      "default": {}
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RelationDefinition"
      },
      "default": {}
    }
  },
  "$defs": {
    "TypeDefinition": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "default": {}
        },
        "indexes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IndexDefinition"
          },
          "default": {}
        },
        "additionalFields": {
          "type": "boolean",
          "default": false
        },
        "shortCode": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "changeOrder": {
          "type": "boolean",
          "default": false
        },
        "declaredBy": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "FieldDefinition": {
      "type": "object",
      "properties": {
        "optional": {
          "type": "boolean",
          "default": false
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int64"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timestamp"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ref"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "onDelete": {
              "$ref": "#/$defs/ProtocolOnDelete",
              "default": "restrict"
            }
          },
          "required": [
            "type",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            },
            "of": {
              "$ref": "#/$defs/FieldSpec"
            }
          },
          "required": [
            "type",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "any"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ProtocolOnDelete": {
      "type": "string",
      "enum": [
        "restrict",
        "setNull",
        "allowDangling"
      ]
    },
    "FieldSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "integer"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int64"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bytes"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timestamp"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ref"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "onDelete": {
              "$ref": "#/$defs/ProtocolOnDelete",
              "default": "restrict"
            }
          },
          "required": [
            "type",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            },
            "of": {
              "$ref": "#/$defs/FieldSpec"
            }
          },
          "required": [
            "type",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "any"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "IndexDefinition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "value"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unique": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "order"
            },
            "field": {
              "type": "string"
            },
            "locale": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "field",
            "locale"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "trigram"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vector"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dims": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "quantization": {
              "type": "string",
              "default": "sq8"
            }
          },
          "required": [
            "kind",
            "fields",
            "dims"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rank"
            },
            "relations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "weighted": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "kind",
            "relations"
          ]
        }
      ]
    },
    "RelationDefinition": {
      "type": "object",
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/ProtocolCardinality",
          "default": "manyToMany"
        },
        "acyclic": {
          "type": "boolean",
          "default": false
        },
        "weighted": {
          "type": "boolean",
          "default": false
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelationEndpoint"
          },
          "default": []
        },
        "declaredBy": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "ProtocolCardinality": {
      "type": "string",
      "enum": [
        "manyToMany",
        "manyToOne",
        "oneToMany",
        "oneToOne"
      ]
    },
    "RelationEndpoint": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ]
    }
  }
}
