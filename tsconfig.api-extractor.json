{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".temp/api-types",
    "outDir": ".temp/api-types",
    "types": []
  },
  "include": ["src/**/*.ts"],
  // Type tests (`*.test-d.ts`) are read by the typecheck, and are no part of the package
  "exclude": ["src/**/*.test-d.ts"]
}
